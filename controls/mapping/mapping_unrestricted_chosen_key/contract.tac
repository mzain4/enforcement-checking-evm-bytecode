function withdrawAll() public {
    Begin block 0x10
    prev=[], succ=[0x20, 0x30]
    =================================
    0x501: 0x501 = CALLER 
    0x51a: 0x51a(0x0) = CONST 
    0x51b: MSTORE 0x51a, 0x501 
    0x51c: 0x51c(0x20) = CONST 
    0x51d: 0x51d(0x1) = CONST 
    0x51e: MSTORE 0x51c, 0x51d 
    0x51f: 0x51f(0x40) = CONST 
    0x51g: 0x51g = SHA3 0x51a, 0x51f 
    0x51h: 0x51h = SLOAD 0x51g 
    0x51i: 0x51i(0x0) = CONST 
    0x51j: 0x51j = NE 0x51h, 0x51i 
    0x51k: 0x51k(0x30) = CONST 
    0x51l: JUMPI 0x51k, 0x51j 
    Begin block 0x20
    prev=[], succ=[]
    =================================
    0x201: 0x201(0x0) = CONST 
    0x202: REVERT 0x201, 0x201 
    Begin block 0x30
    prev=[], succ=[]
    =================================
    0x800: 0x800(0x8fc) = CONST 
    0x801: 0x801 = CALLER 
    0x802: 0x802 = SELFBALANCE 
    0x803: 0x803(0x0) = CONST 
    0x804: 0x804(0x0) = CONST 
    0x805: 0x19 = CALL 0x800, 0x801, 0x802, 0x803, 0x804, 0x803, 0x804 
    0x601: STOP 
}

